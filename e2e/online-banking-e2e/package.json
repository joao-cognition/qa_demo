{
  "name": "online-banking-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end suite for online-banking-web. Lives apart from the application, as the customer's suites do.",
  "scripts": {
    "test": "playwright test",
    "test:desktop": "playwright test --project=desktop-chromium",
    "test:mobile": "playwright test --project=mobile-android --project=mobile-ios",
    "test:smoke": "playwright test --grep @smoke",
    "report": "playwright show-report",
    "xray:export": "node xray/export-results.mjs test-results/results.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.14.0"
  }
}
